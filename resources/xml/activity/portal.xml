<brls:AppletFrame
    backgroundColor="#F2F3F5"
    headerHidden="false"
    footerHidden="false">
    <brls:Box
        axis="column"
        width="100%"
        height="100%"
        paddingTop="30"
        paddingBottom="28"
        paddingLeft="56"
        paddingRight="56">
        <brls:Label id="portal/title" fontSize="32" textColor="#171C27" text="PORTAL TV" />
        <brls:Label
            id="portal/state"
            marginTop="8"
            fontSize="17"
            textColor="#ED7112"
            text="CONFIGURACION PENDIENTE" />

        <brls:Box
            axis="column"
            width="100%"
            marginTop="26"
            backgroundColor="#FFFFFF"
            paddingTop="26"
            paddingBottom="26"
            paddingLeft="30"
            paddingRight="30">
            <brls:Label fontSize="15" textColor="#667085" text="SERVIDOR AUTORIZADO" />
            <brls:Label id="portal/host" marginTop="7" fontSize="20" textColor="#171C27" text="Sin servidor" />
            <brls:Box axis="row" width="100%" marginTop="24">
                <brls:Box axis="column" grow="1" marginRight="20">
                    <brls:Label fontSize="14" textColor="#667085" text="CODIGO DE PORTAL" />
                    <brls:Label id="portal/code" marginTop="6" fontSize="18" textColor="#171C27" text="No configurado" />
                </brls:Box>
                <brls:Box axis="column" grow="1">
                    <brls:Label fontSize="14" textColor="#667085" text="DISPOSITIVO" />
                    <brls:Label id="portal/device" marginTop="6" fontSize="18" textColor="#171C27" text="No configurado" />
                </brls:Box>
            </brls:Box>
            <brls:Label
                id="portal/detail"
                marginTop="26"
                fontSize="16"
                textColor="#475467"
                text="Carga los datos de tu servicio en config.json." />
        </brls:Box>

        <brls:Box axis="row" width="100%" marginTop="22">
            <brls:Button id="portal/reload" grow="1" marginRight="14" text="RECARGAR CONFIG" />
            <brls:Button id="portal/probe" grow="1" text="PROBAR SERVIDOR" />
        </brls:Box>

        <brls:Box grow="1" />
        <brls:Label
            fontSize="14"
            textColor="#667085"
            text="Ruta: sdmc:/switch/XuitchTV/config.json" />
        <brls:Label
            marginTop="6"
            fontSize="13"
            textColor="#98A2B3"
            text="XuitchTV no incluye cuentas, contenido ni mecanismos para evadir autenticacion o DRM." />
    </brls:Box>
</brls:AppletFrame>
