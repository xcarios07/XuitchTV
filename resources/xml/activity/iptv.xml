<brls:AppletFrame
    backgroundColor="#F2F3F5"
    headerHidden="false"
    footerHidden="false">
    <brls:Box
        axis="column"
        width="100%"
        height="100%"
        backgroundColor="#F2F3F5"
        paddingTop="24"
        paddingBottom="22"
        paddingLeft="46"
        paddingRight="46">
        <brls:Box axis="row" width="100%" height="64" alignItems="center">
            <brls:Box axis="column" grow="1">
                <brls:Label fontSize="31" textColor="#171C27" text="TV EN VIVO" />
                <brls:Label id="iptv/status" marginTop="4" fontSize="15" textColor="#667085" text="Listo" />
            </brls:Box>
            <brls:Label id="iptv/count" width="140" fontSize="16" textColor="#ED7112" text="0 canales" />
            <brls:Button id="iptv/refresh" width="190" text="Actualizar" />
        </brls:Box>

        <brls:Box axis="row" width="100%" grow="1" marginTop="20">
            <brls:Box
                axis="column"
                width="300"
                height="100%"
                marginRight="22"
                backgroundColor="#FFFFFF"
                paddingTop="18"
                paddingBottom="18"
                paddingLeft="16"
                paddingRight="16">
                <brls:Label fontSize="19" textColor="#ED7112" text="CATEGORIAS" marginBottom="12" />
                <brls:ScrollingFrame grow="1" scrollingBehavior="natural">
                    <brls:Box id="iptv/categories" axis="column" width="100%" />
                </brls:ScrollingFrame>
            </brls:Box>

            <brls:Box
                axis="column"
                grow="1"
                height="100%"
                backgroundColor="#E9EAED"
                paddingTop="18"
                paddingBottom="18"
                paddingLeft="18"
                paddingRight="18">
                <brls:Label fontSize="19" textColor="#171C27" text="CANALES DE PARAGUAY" marginBottom="12" />
                <brls:ScrollingFrame grow="1" scrollingBehavior="natural">
                    <brls:Box id="iptv/channels" axis="column" width="100%" />
                </brls:ScrollingFrame>
            </brls:Box>
        </brls:Box>
    </brls:Box>
</brls:AppletFrame>
